# ---------------------------------------------------------------
# LYFE — environment variables
# Copy to .env and fill in. NEVER commit .env to git.
# ---------------------------------------------------------------

# Telegram
BOT_TOKEN=123456:REPLACE_ME_WITH_TOKEN_FROM_BOTFATHER
BOT_USERNAME=LYFE_REQUEST_BOT

# Database (host/port are the docker-compose service names)
POSTGRES_USER=lyfe
POSTGRES_PASSWORD=change_me_to_a_long_random_string
POSTGRES_DB=lyfe
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# App
DEFAULT_LANGUAGE=ru
ENV=dev
LOG_LEVEL=INFO

# Limits (Phase 1)
MAX_REQUESTS_PER_USER_PER_EVENT=3

# Points
POINTS_MUSIC_REQUEST=1
POINTS_VOTE=1
POINTS_ATTENDANCE=10

# Optional, add later
SENTRY_DSN=
