# ---------------------------------------------------------------
# LYFE — environment variables
# Copy to .env and fill in. NEVER commit .env to git.
# ---------------------------------------------------------------

# Telegram
BOT_TOKEN=123456:REPLACE_ME_WITH_TOKEN_FROM_BOTFATHER
BOT_USERNAME=LYFE_REQUEST_BOT

# Database (host/port are the docker-compose service names)
POSTGRES_USER=lyfe
POSTGRES_PASSWORD=change_me_to_a_long_random_string
POSTGRES_DB=lyfe
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# App
DEFAULT_LANGUAGE=ru
ENV=dev
LOG_LEVEL=INFO

# Limits (Phase 1)
MAX_REQUESTS_PER_USER_PER_EVENT=3

# Points
POINTS_MUSIC_REQUEST=1
# Zero on purpose — see config.py
POINTS_VOTE=0
POINTS_ATTENDANCE=10

# Rewards
COST_PRIORITY_TRACK=40

# Domain for the DJ screen and door scanner (production only).
# The scanner camera requires https, so a real hostname is mandatory.
DOMAIN=lyfe.example.com

# DJ live screen / web admin
# Generate with: openssl rand -hex 32
ADMIN_SECRET_KEY=replace_me_with_a_long_random_hex_string
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Optional, add later
SENTRY_DSN=
